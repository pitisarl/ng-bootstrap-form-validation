{
  "name": "ng-bootstrap-form-validation",
  "version": "21.0.0",
  "engine": {
    "node": ">=18.13.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build_lib": "ng build ng-bootstrap-form-validation",
    "npm_pack": "cd dist/ng-bootstrap-form-validation && npm pack",
    "package": "npm run build_lib && npm run npm_pack",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "clean": "rimraf dist && rimraf .ng_build",
    "pretty": "prettier --write \"**/*.ts\"",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.ts": [
      "npm run pretty",
      "git add"
    ]
  },
  "description": "An Angular module that makes Bootstrap form validation easy.",
  "license": "MIT",
  "keywords": [
    "angular",
    "bootstrap",
    "form",
    "validation"
  ],
  "author": "Kevin Kipp",
  "repository": {
    "url": "https://github.com/third774/ng-bootstrap-form-validation"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.4",
    "@angular/common": "^21.1.4",
    "@angular/compiler": "^21.1.4",
    "@angular/core": "^21.1.4",
    "@angular/forms": "^21.1.4",
    "@angular/platform-browser": "^21.1.4",
    "@angular/platform-browser-dynamic": "^21.1.4",
    "@angular/router": "^21.1.4",
    "core-js": "^3.48.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.4",
    "@angular/language-service": "^21.1.4",
    "@types/jasmine": "~3.10.19",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^24.10.13",
    "husky": "^9.1.7",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lint-staged": "^16.2.7",
    "ng-packagr": "^21.1.0",
    "ng2-mock-component": "^0.2.0",
    "prettier": "3.8.1",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.3",
    "typescript": "~5.9.3"
  }
}
